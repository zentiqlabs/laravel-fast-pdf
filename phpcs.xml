<?xml version="1.0"?>
<ruleset name="ZentiqLabs Laravel Fast PDF">
    <description>PSR-12 coding standard for zentiq-labs/laravel-fast-pdf</description>

    <file>src</file>
    <file>tests</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <!-- Pest test files define helper functions alongside test closures -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
